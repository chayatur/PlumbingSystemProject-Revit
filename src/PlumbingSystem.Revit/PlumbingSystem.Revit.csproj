<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PlumbingSystem.Revit</RootNamespace>
    <AssemblyName>PlumbingSystem.Revit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Revit טוען את ה-Add-in כ-DLL רגיל, לא כאפליקציה - אין צורך ב-exe. -->
    <OutputType>Library</OutputType>
    <!-- נדרש עבור חלון-ההתקדמות (PlumbingSystem.Revit.Progress) - ראו
         docs/progress-infrastructure.md. Revit עצמו מבוסס-WPF, אז
         ה-assemblies האלה כבר טעונים בתהליך שלו ממילא. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlumbingSystem.Core\PlumbingSystem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RevitAPI.dll / RevitAPIUI.dll מגיעות מהתקנת Revit על המחשב שמריץ אותו,
         ולכן Private=False (HintPath בלבד, בלי להעתיק ל-bin). אם יועתקו,
         עלול להיווצר קונפליקט גרסאות מול ה-DLL שכבר טעון בתהליך של Revit. -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="PlumbingSystem.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- קובץ-ההגדרות המשרדי (ראו Config/OfficeConfig.cs) - מועתק לצד ה-DLL
         כדי שהתוסף יקרא אותו בזמן ריצה. גם מועתק לתיקיית ה-Add-ins של
         Revit ב-Target "CopyAddinToRevit" למטה. -->
    <None Include="PlumbingSystem.OfficeConfig.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- תיקיית ה-Add-ins הפר-משתמשית שממנה Revit 2027 טוען manifests בעליה.
         NOTE: זו לא $(ProgramData)! ה-journal של Revit (journal.0013.txt)
         מראה בפירוש שהוא דוחה manifest מ-%ProgramData%\Autodesk\Revit\Addins\2027
         עם ההודעה "All-users Add-in manifest files must be installed to:
         C:\Program Files\Autodesk\Revit\Addins\2027" - אבל לתיקייה הזו
         (תחת Program Files) אין הרשאת כתיבה למשתמש רגיל בלי הרשאת
         Administrator. לכן משתמשים בתיקיית ה-Add-ins הפר-משתמשית
         (Roaming AppData), שכן ניתנת לכתיבה וכבר קיימת (Revit עצמו יצר
         אותה בהתקנה). -->
    <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2027\</RevitAddinsDir>
  </PropertyGroup>

  <!-- מעתיק את פלט ה-build (וה-manifest) לתיקיית ה-Add-ins של Revit אחרי כל
       build, כדי שלא יהיה צורך להעתיק ידנית בכל פעם ו-Revit תמיד יראה את
       הגרסה העדכנית ביותר.

       חשוב: מעתיק את **כל** ה-DLL/PDB מ-$(TargetDir), לא רק
       $(AssemblyName).dll - כלומר גם PlumbingSystem.Core.dll (וכל תלות
       עתידית). אחרת Revit טוען PlumbingSystem.Revit.dll חדש לצד
       PlumbingSystem.Core.dll ישן שנשאר מ-build קודם, ונופל עם
       "Could not load type 'PlumbingSystem.Core.Domain.<טיפוס חדש>'".
       RevitAPI/RevitAPIUI מוחרגים במפורש (Private=false ממילא מונע את
       העתקתם, זו רשת-ביטחון) - אסור להעתיק אותם לתיקיית ה-Add-ins, זה
       יוצר קונפליקט-גרסאות מול ה-DLL שכבר טעון בתהליך של Revit.

       ContinueOnError="WarnAndContinue": כש-Revit פתוח הוא **נועל** את
       ה-DLL-ים בתיקיית ה-Add-ins וההעתקה נכשלת. זה לא צריך להכשיל את כל
       ה-build (הקומפילציה עצמה הצליחה) - מודפסת אזהרה, וצריך לסגור ולפתוח
       מחדש את Revit כדי שהגרסה החדשה תיטען. -->
  <Target Name="CopyAddinToRevit" AfterTargets="Build">
    <ItemGroup>
      <RevitAddinFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)RevitAPI*.dll" />
      <RevitAddinFiles Include="$(TargetDir)*.pdb" />
      <RevitAddinFiles Include="$(ProjectDir)PlumbingSystem.addin" />
      <RevitAddinFiles Include="$(ProjectDir)PlumbingSystem.OfficeConfig.txt" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)" Condition="!Exists('$(RevitAddinsDir)')" />
    <Copy SourceFiles="@(RevitAddinFiles)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
    <Warning Text="לא ניתן להעתיק חלק מקבצי ה-Add-in ל-$(RevitAddinsDir) - כנראה Revit פתוח ונועל אותם. סגור ופתח מחדש את Revit כדי לטעון את הגרסה החדשה."
             Condition="'$(MSBuildLastTaskResult)' == 'false'" />
  </Target>

</Project>
