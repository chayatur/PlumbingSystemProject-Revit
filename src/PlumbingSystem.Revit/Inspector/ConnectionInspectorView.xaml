<UserControl x:Class="PlumbingSystem.Revit.Inspector.ConnectionInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220" Background="White">
    <StackPanel Margin="12">
        <TextBlock Text="Connection Inspector" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding ConnectedItems}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Highlight Related" Padding="10,6" HorizontalAlignment="Left"
                IsEnabled="{Binding HasRelationship}" Click="HighlightButton_Click"/>
    </StackPanel>
</UserControl>
